# Optional AI review. Leave AUDIT_AI_PROVIDER empty for deterministic-only mode.
# "both" uses Groq first for speed and Gemini as a fallback if the first
# provider is unavailable or returns an invalid contract-compliant plan.
AUDIT_AI_PROVIDER=both
AUDIT_AI_TIMEOUT_SECONDS=20
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
